# Configuration SMTP pour le formulaire de contact
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@bkntech.fr
SMTP_PASS=votre_mot_de_passe_ici
SMTP_TO=contact@bkntech.fr
# Empreinte (scrypt) du mot de passe admin. JAMAIS le mot de passe lui-même.
# Génération : node scripts/admin-password.mjs
ADMIN_PASSWORD_HASH=

# Discord Webhook pour la publication automatique des Devlogs Vacuum
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_URL"

# Cloudflare Turnstile Anti-Spam (Optionnel)
TURNSTILE_SECRET_KEY=votre_cle_secrete_turnstile

# Offre de lancement B-Ledger : identifiant client OAuth Google (type Application Web).
# Public (pas un secret), mais requis : sans lui, la page /b-ledger/offre est désactivée.
GOOGLE_CLIENT_ID=votre_id_client.apps.googleusercontent.com
# Optionnel : emplacement de la base SQLite (défaut : api/data/promo.sqlite).
# PROMO_DB_PATH=
# Empreinte (SHA-256) de la clé API des codes promo (serveur MCP). Vide = clé désactivée.
# Génération : node scripts/promo-api-key.mjs (la clé elle-même va seulement dans mcp/.env).
PROMO_API_KEY_HASH=
# Empreinte (SHA-256) de la clé API des articles du portfolio (outils MCP). Vide = clé désactivée.
# Génération : node scripts/posts-api-key.mjs (la clé elle-même va seulement dans mcp/.env).
POSTS_API_KEY_HASH=
